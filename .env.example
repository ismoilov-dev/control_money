# Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyz

# Your numeric Telegram user ID (the bot ignores everyone else).
# Get it from @userinfobot or @getmyid_bot
ALLOWED_USER_ID=123456789

# Optional: SQLite file path (default: data/expenses.db)
# DATABASE_PATH=data/expenses.db

# Optional: IANA timezone for "today/week/month" and the daily reminder
# TIMEZONE=Asia/Tashkent

# Google Gemini API key for NLP, Voice STT, Receipt OCR, and Financial Advice Chat
# Note: google-genai SDK requires Python 3.10+
GEMINI_API_KEY=your_gemini_api_key_here


